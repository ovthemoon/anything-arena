# ─────────────────────────────────────────────────────────────
# 로컬 개발용 비밀 키 템플릿 (PRD 부록 C: 공개 설정과 분리된 Secret)
#   1) 복사:  cp .env.example .env
#   2) 필요한 키만 채우기 (안 쓰는 건 비워둬도 됨)
#   3) .env 는 git 에 올라가지 않음 (.gitignore 처리됨)
#
# 배포(Cloudflare)에서는 .env 대신 키마다 아래 명령으로 등록:
#   npx wrangler secret put ELEVENLABS_API_KEY
# 공개 설정값(HP, 라운드 수, 모델명 등)은 wrangler.jsonc 의 vars 에 있음.
# ─────────────────────────────────────────────────────────────

# ── OpenRouter : 한 키로 여러 모델(텍스트·이미지 생성·TTS) 호출. 기본 구성은 이걸로 시작 ──
OPENROUTER_API_KEY=

# ── Jev (TypeSafe) : 입력 허용 여부·공격 상성·연출 분류 판정 ──
TYPESAFE_API_KEY=

# ── 텍스트 모델 : 무기 설정 생성, 해설 문장 (하나만 골라 써도 됨) ──
GOOGLE_AI_API_KEY=         # Gemini (구조화 출력 지원, PRD 초기 후보)
OPENAI_API_KEY=            # GPT / gpt-image
ANTHROPIC_API_KEY=         # Claude

# ── TTS : 중계 음성 ──
ELEVENLABS_API_KEY=        # eleven_flash_v2_5

# ── 이미지 생성 (확장 항목, MVP 필수 아님) ──
REPLICATE_API_TOKEN=       # Flux, SDXL 등
STABILITY_API_KEY=         # Stable Diffusion 공식 API

# ── Cloudflare (CI 배포용, 로컬 개발엔 불필요. GitHub Secrets 에 넣는 값) ──
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
